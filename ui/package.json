{
  "name": "@trade-gateway/ui",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "npm run build:client && npm run build:server",
    "build:client": "vite build --mode client",
    "build:server": "vite build --ssr app/server.ts --outDir dist/server",
    "start": "node dist/server/server.js",
    "test": "node --import tsx --test app/**/*.test.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@hono/node-server": "^1.19.11",
    "@trade-gateway/api": "1.0.0",
    "hono": "^4.12.12",
    "honox": "^0.1.55"
  },
  "devDependencies": {
    "@hono/vite-dev-server": "^0.18.2",
    "@tailwindcss/vite": "^4.0.9",
    "tailwindcss": "^4.0.9",
    "vite": "^6.3.5"
  }
}
